@model IEnumerable<quan_ly_chi_tieu.Models.InvestmentAsset>
@{
    ViewData["Title"] = "Danh mục đầu tư";
    var wallets = ViewBag.Wallets as List<quan_ly_chi_tieu.Models.Wallet> ?? new();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
    <div>
        <h1 class="fw-bold mb-1">📈 Danh mục đầu tư</h1>
        <p class="text-muted mb-0">Theo dõi và quản lý tài sản tích lũy: Cổ phiếu, Crypto, Vàng...</p>
    </div>
    <button type="button" class="btn btn-primary btn-lg shadow-lg px-4" data-bs-toggle="modal" data-bs-target="#addAssetModal">
        <i class="bi bi-plus-lg me-2"></i>Thêm tài sản mới
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-5 p-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="display-1 mb-4">📊</div>
            <h3 class="fw-bold text-muted">Chưa có tài sản nào trong danh mục</h3>
            <p class="text-muted mb-4">Bắt đầu theo dõi hành trình tự do tài chính của bạn bằng cách thêm mã cổ phiếu hoặc tài sản đầu tiên.</p>
            <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addAssetModal">Thêm tài sản ngay</button>
        </div>
    }
    @foreach (var asset in Model)
    {
        var totalQty = asset.InvestmentTransactions.Where(t => t.ActionType == "BUY").Sum(t => t.Quantity)
                       - asset.InvestmentTransactions.Where(t => t.ActionType == "SELL").Sum(t => t.Quantity);
        var totalCost = asset.InvestmentTransactions.Where(t => t.ActionType == "BUY").Sum(t => t.Quantity * t.UnitPrice);
        var avgPrice = totalQty > 0 ? totalCost / asset.InvestmentTransactions.Where(t => t.ActionType == "BUY").Sum(t => t.Quantity) : 0;
        
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-header border-0 bg-white pt-4 px-4 pb-2">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 mb-2 small fw-bold">@asset.AssetType</span>
                            <h2 class="fw-bold mb-0">@asset.Symbol</h2>
                            <p class="text-muted small mb-0">@asset.Name</p>
                        </div>
                        <div class="text-end">
                            <h4 class="fw-bold mb-0">@totalQty.ToString("N3")</h4>
                            <small class="text-muted text-uppercase fw-bold opacity-50 small">Sở hữu</small>
                        </div>
                    </div>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="p-3 bg-light rounded-4 mb-4">
                        <div class="row g-0">
                            <div class="col-6 border-end">
                                <small class="text-muted d-block mb-1 small fw-bold text-uppercase">Giá vốn TB</small>
                                <span class="fw-bold fs-5">@avgPrice.ToString("N0")<span class="small fw-normal">đ</span></span>
                            </div>
                            <div class="col-6 ps-3">
                                <small class="text-muted d-block mb-1 small fw-bold text-uppercase">Giá hiện tại</small>
                                <span class="fw-bold text-primary fs-5">@(asset.CurrentPrice?.ToString("N0") ?? "---")<span class="small fw-normal">đ</span></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-success flex-fill fw-bold py-2 rounded-3 shadow-sm" 
                                data-bs-toggle="modal" data-bs-target="#tradeModal" 
                                data-assetid="@asset.Id" data-symbol="@asset.Symbol" data-type="BUY">
                            <i class="bi bi-arrow-up-circle me-1"></i> MUA
                        </button>
                        <button class="btn btn-outline-danger flex-fill fw-bold py-2 rounded-3 shadow-sm" 
                                data-bs-toggle="modal" data-bs-target="#tradeModal" 
                                data-assetid="@asset.Id" data-symbol="@asset.Symbol" data-type="SELL" @(totalQty <= 0 ? "disabled" : "")>
                            <i class="bi bi-arrow-down-circle me-1"></i> BÁN
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Asset Modal -->
<div class="modal fade" id="addAssetModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 px-4 pt-4 pb-0">
                <h5 class="modal-title fw-bold fs-4">Thêm tài sản mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateAsset" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Phân loại tài sản</label>
                        <select name="AssetType" class="form-select form-select-lg rounded-3">
                            <option value="STOCK">📈 Cổ phiếu (VN/Global)</option>
                            <option value="CRYPTO">🪙 Tiền điện tử (Crypto)</option>
                            <option value="GOLD">✨ Vàng & Kim loại quý</option>
                            <option value="REAL_ESTATE">🏠 Bất động sản</option>
                            <option value="FOREX">💵 Ngoại tệ</option>
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-5">
                            <label class="form-label small fw-bold text-uppercase text-muted">Mã (Symbol)</label>
                            <input name="Symbol" class="form-control form-control-lg rounded-3 fw-bold" placeholder="BTC, VNM..." required />
                        </div>
                        <div class="col-7">
                            <label class="form-label small fw-bold text-uppercase text-muted">Tên đầy đủ</label>
                            <input name="Name" class="form-control form-control-lg rounded-3" placeholder="Tên tài sản..." required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-lg">Xác nhận thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Trade Modal (Buy/Sell) -->
<div class="modal fade" id="tradeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 px-4 pt-4 pb-0">
                <h5 class="modal-title fw-bold fs-4" id="tradeModalTitle">Lệnh giao dịch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ProcessTransaction" method="post">
                <input type="hidden" name="AssetId" id="tradeAssetId" />
                <input type="hidden" name="TransactionType" id="tradeType" />
                <div class="modal-body p-4 text-center">
                    <div class="mb-4">
                        <span id="tradeSymbol" class="display-4 fw-bold text-primary"></span>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Số lượng</label>
                            <input name="Quantity" class="form-control form-control-lg text-center fw-bold" type="number" step="0.000001" required placeholder="0.0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Giá khớp (VNĐ)</label>
                            <input name="Price" class="form-control form-control-lg text-center fw-bold" type="number" step="1" required placeholder="0" />
                        </div>
                    </div>
                    <div class="mb-4 text-start">
                        <label class="form-label small fw-bold text-uppercase text-muted">Ví thanh toán</label>
                        <select name="WalletId" class="form-select rounded-3" required>
                            @foreach (var w in wallets)
                            {
                                <option value="@w.Id">@w.Icon @w.Name — Số dư: @w.CurrentBalance?.ToString("N0") đ</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2 text-start">
                        <label class="form-label small fw-bold text-uppercase text-muted">Ngày thực hiện</label>
                        <input name="Date" class="form-control rounded-3" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 justify-content-center">
                    <button type="submit" class="btn btn-primary btn-lg w-100 shadow-lg py-3" id="tradeSubmitBtn">Xác nhận giao dịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const tradeModal = document.getElementById('tradeModal');
        tradeModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const assetId = button.getAttribute('data-assetid');
            const symbol = button.getAttribute('data-symbol');
            const type = button.getAttribute('data-type');
            
            tradeModal.querySelector('#tradeAssetId').value = assetId;
            tradeModal.querySelector('#tradeSymbol').innerText = symbol;
            tradeModal.querySelector('#tradeType').value = type;
            tradeModal.querySelector('#tradeModalTitle').innerText = (type === 'BUY' ? '🟢 Lệnh MUA tài sản' : '🔴 Lệnh BÁN tài sản');
            
            const btn = tradeModal.querySelector('#tradeSubmitBtn');
            btn.className = 'btn btn-lg w-100 shadow-lg py-3 ' + (type === 'BUY' ? 'btn-success' : 'btn-danger');
            btn.innerHTML = (type === 'BUY' ? '<i class="bi bi-cart-plus me-2"></i>MUA NGAY' : '<i class="bi bi-cart-dash me-2"></i>BÁN NGAY');
        });
    </script>
}
