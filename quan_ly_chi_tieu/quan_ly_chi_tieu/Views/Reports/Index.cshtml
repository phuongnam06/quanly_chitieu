@model quan_ly_chi_tieu.Models.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Báo cáo phân tích";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="fw-bold mb-0">📊 Báo cáo phân tích</h2>
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn btn-primary px-4">Lọc</button>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3" style="background: linear-gradient(135deg, #1d976c, #93f9b9); color: white;">
                <h6 class="text-uppercase small mb-1">Tổng thu nhập</h6>
                <h3 class="fw-bold mb-0">@Model.TotalIncome.ToString("N0") đ</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3" style="background: linear-gradient(135deg, #eb3349, #f45c43); color: white;">
                <h6 class="text-uppercase small mb-1">Tổng chi tiêu</h6>
                <h3 class="fw-bold mb-0">@Model.TotalExpense.ToString("N0") đ</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3" style="background: linear-gradient(135deg, #4b6cb7, #182848); color: white;">
                <h6 class="text-uppercase small mb-1">Số dư thuần</h6>
                <h3 class="fw-bold mb-0">@Model.NetBalance.ToString("N0") đ</h3>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Spending by Category (Donut Chart) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">🧵 Chi tiêu theo danh mục</h5>
                </div>
                <div class="card-body">
                    @if (Model.SpendingByCategory != null && Model.SpendingByCategory.Any())
                    {
                        <div style="height: 300px;">
                            <canvas id="categoryChart"></canvas>
                        </div>
                        <div class="mt-4">
                            @foreach (var item in Model.SpendingByCategory.Take(5))
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width: 12px; height: 12px; border-radius: 50%; background-color: @item.Color;"></div>
                                        <span>@item.CategoryName</span>
                                    </div>
                                    <span class="text-muted fw-bold">@item.Percentage.ToString("0.1")%</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h1 class="display-1 text-light">🍽️</h1>
                            <p class="text-muted">Chưa có dữ liệu chi tiêu trong khoảng thời gian này.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Daily Trends (Bar Chart) -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">📈 Xu hướng thu chi hàng ngày</h5>
                </div>
                <div class="card-body">
                    <div style="height: 400px;">
                        <canvas id="trendsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Category Chart
        @if (Model.SpendingByCategory != null && Model.SpendingByCategory.Any())
        {
            <text>
            const ctxCat = document.getElementById('categoryChart').getContext('2d');
            new Chart(ctxCat, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.SpendingByCategory.Select(x => x.CategoryName))),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.SpendingByCategory.Select(x => x.Amount))),
                        backgroundColor: @Html.Raw(Json.Serialize(Model.SpendingByCategory.Select(x => x.Color ?? "#4e73df"))),
                        borderWidth: 0,
                        hoverOffset: 20
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    cutout: '70%'
                }
            });
            </text>
        }

        // Trends Chart
        const ctxTrends = document.getElementById('trendsChart').getContext('2d');
        new Chart(ctxTrends, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.DailyTrends?.Select(x => x.DateLabel) ?? new List<string>())),
                datasets: [
                    {
                        label: 'Thu nhập',
                        data: @Html.Raw(Json.Serialize(Model.DailyTrends?.Select(x => x.Income) ?? new List<decimal>())),
                        backgroundColor: '#1d976c',
                        borderRadius: 5
                    },
                    {
                        label: 'Chi tiêu',
                        data: @Html.Raw(Json.Serialize(Model.DailyTrends?.Select(x => x.Expense) ?? new List<decimal>())),
                        backgroundColor: '#eb3349',
                        borderRadius: 5
                    }
                ]
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                },
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
}
