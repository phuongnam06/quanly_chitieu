@model IEnumerable<quan_ly_chi_tieu.Models.Category>
@{
    ViewData["Title"] = "Danh mục thu chi";
    var expenses = Model.Where(c => c.Type == "EXPENSE");
    var incomes = Model.Where(c => c.Type == "INCOME");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🏷️ Danh mục thu chi</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm danh mục</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-6">
        <h5 class="text-danger fw-bold">💸 Chi tiêu (@expenses.Count())</h5>
        @if (!expenses.Any())
        {
            <p class="text-muted">Chưa có danh mục chi tiêu nào.</p>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var cat in expenses.OrderBy(c => c.ParentId).ThenBy(c => c.Name))
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span style="background-color: @cat.Color; padding: 2px 8px; border-radius: 50%; color: white;">@cat.Icon</span>
                            @if (cat.ParentId.HasValue)
                            {
                                <span class="text-muted ms-2">↳</span>
                            }
                            <span class="ms-2 fw-@(cat.ParentId == null ? "bold" : "normal")">@cat.Name</span>
                            @if (cat.ParentId.HasValue)
                            {
                                <small class="text-muted ms-1">(thuộc @cat.Parent?.Name)</small>
                            }
                        </div>
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary">✏️</a>
                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('Xóa danh mục này?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit">🗑️</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-md-6">
        <h5 class="text-success fw-bold">💰 Thu nhập (@incomes.Count())</h5>
        @if (!incomes.Any())
        {
            <p class="text-muted">Chưa có danh mục thu nhập nào.</p>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var cat in incomes.OrderBy(c => c.ParentId).ThenBy(c => c.Name))
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span style="background-color: @cat.Color; padding: 2px 8px; border-radius: 50%; color: white;">@cat.Icon</span>
                            @if (cat.ParentId.HasValue)
                            {
                                <span class="text-muted ms-2">↳</span>
                            }
                            <span class="ms-2 fw-@(cat.ParentId == null ? "bold" : "normal")">@cat.Name</span>
                        </div>
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary">✏️</a>
                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('Xóa danh mục này?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit">🗑️</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
