@model quan_ly_chi_tieu.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row min-vh-75 align-items-center justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold mb-2">💎 Gia nhập FinTrack Pro</h1>
            <p class="text-muted">Kiến tạo tương lai tài chính vững chắc ngay hôm nay</p>
        </div>

        <div class="card border-0 shadow-lg p-2 rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="FullName" class="form-label fw-bold small text-uppercase">Họ và tên</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="VD: Nguyễn Văn A" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold small text-uppercase">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold small text-uppercase">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control border-start-0 ps-0" type="password" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6 mt-3 mt-md-0">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold small text-uppercase">Xác nhận</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0" type="password" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4 small text-muted">
                        Bằng cách nhấn đăng ký, bạn đồng ý với <a href="#" class="text-decoration-none">Điều khoản sử dụng</a> và <a href="#" class="text-decoration-none">Chính sách bảo mật</a> của chúng tôi.
                    </div>

                    <button class="btn btn-primary btn-lg w-100 py-3 shadow-lg mb-4" type="submit">
                        <i class="bi bi-check-circle me-2"></i> Đăng ký ngay
                    </button>

                    <div class="text-center mt-2">
                        <p class="mb-0 text-muted small">Đã là thành viên? <a asp-action="Login" class="fw-bold text-decoration-none">Đăng nhập tại đây</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
