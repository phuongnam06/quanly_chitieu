@model quan_ly_chi_tieu.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row min-vh-75 align-items-center justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold mb-2">💎 FinTrack Pro</h1>
            <p class="text-muted">Đăng nhập để tiếp tục hành trình tài chính của bạn</p>
        </div>

        <div class="card border-0 shadow-lg p-3 rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-4"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold small text-uppercase">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label fw-bold small text-uppercase mb-0">Mật khẩu</label>
                            <a href="#" class="small text-decoration-none">Quên mật khẩu?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control border-start-0 ps-0" type="password" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label text-muted" asp-for="RememberMe">Duy trì đăng nhập trong 30 ngày</label>
                    </div>
                    
                    <button class="btn btn-primary btn-lg w-100 py-3 shadow-lg mb-4" type="submit">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập ngay
                    </button>

                    <div class="text-center mt-2">
                        <p class="mb-0 text-muted small">Chưa có tài khoản? <a asp-action="Register" class="fw-bold text-decoration-none">Đăng ký thành viên mới</a></p>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="mt-5 text-center text-muted small">
            <p>&copy; 2026 FinTrack Pro Security System. <br/> Bảo mật bởi mã hóa AES-256.</p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
