@model IEnumerable<quan_ly_chi_tieu.Models.Subscription>
@{
    ViewData["Title"] = "Giao dịch định kỳ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">📅 Giao dịch định kỳ</h2>
        <p class="text-muted">Quản lý các khoản thu chi lặp lại như tiền nhà, lương, dịch vụ đăng ký...</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">+ Thêm lịch định kỳ</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div style="font-size: 4rem">🗓️</div>
            <h4 class="text-muted mt-3">Chưa có giao dịch định kỳ nào</h4>
            <a asp-action="Create" class="btn btn-primary mt-2">Tạo lịch đầu tiên</a>
        </div>
    }
    else
    {
        @foreach (var sub in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                                     style="width: 45px; height: 45px; background: @(sub.Category?.Color ?? "#ccc")20; color: @(sub.Category?.Color ?? "#ccc");">
                                    <span>@(sub.Category?.Icon ?? "🔔")</span>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0">@sub.Name</h5>
                                    <small class="text-muted">@sub.Category?.Name</small>
                                </div>
                            </div>
                            <span class="badge @(sub.Type == "INCOME" ? "bg-success" : "bg-danger")">@(sub.Type == "INCOME" ? "+" : "-")</span>
                        </div>
                        
                        <div class="mb-3">
                            <h3 class="fw-bold @(sub.Type == "INCOME" ? "text-success" : "text-danger") mb-1">
                                @sub.Amount.ToString("N0") đ
                            </h3>
                            <div class="text-muted small">
                                <i class="bi bi-arrow-repeat"></i> 
                                Tần suất: <strong>@(sub.Frequency == "MONTHLY" ? "Hàng tháng" : sub.Frequency == "WEEKLY" ? "Hàng tuần" : "Hàng năm")</strong>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 mb-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Ngày bắt đầu:</span>
                                <span>@sub.StartDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Lần tiếp theo:</span>
                                <span class="fw-bold text-primary">@sub.NextExecutionDate.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge @(sub.IsAutoInsert == true ? "bg-info text-dark" : "bg-warning text-dark")">
                                @(sub.IsAutoInsert == true ? "Tự động ghi" : "Nhắc nhở thủ công")
                            </span>
                            <form asp-action="Delete" asp-route-id="@sub.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa lịch định kỳ này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link text-danger p-0 text-decoration-none">Xóa lịch</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
