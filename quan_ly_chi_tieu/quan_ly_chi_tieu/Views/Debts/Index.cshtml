@model IEnumerable<quan_ly_chi_tieu.Models.Debt>
@{
    ViewData["Title"] = "Quản lý công nợ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">⚖️ Quản lý công nợ</h2>
        <p class="text-muted">Theo dõi các khoản bạn đang nợ và các khoản người khác nợ bạn.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">+ Thêm khoản nợ/vay</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm bg-danger text-white p-3">
            <small class="text-uppercase opacity-75">Tổng tiền tôi nợ</small>
            <h2 class="fw-bold mb-0">@Model.Where(d => d.DebtType == "BORROWED" && d.Status == "ACTIVE").Sum(d => d.RemainingAmount).ToString("N0") đ</h2>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm bg-success text-white p-3">
            <small class="text-uppercase opacity-75">Tổng tiền người khác nợ tôi</small>
            <h2 class="fw-bold mb-0">@Model.Where(d => d.DebtType == "LENT" && d.Status == "ACTIVE").Sum(d => d.RemainingAmount).ToString("N0") đ</h2>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-0">
        <ul class="nav nav-pills card-header-pills" id="debtTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="borrowed-tab" data-bs-toggle="pill" data-bs-target="#borrowed" type="button">Tôi đi vay (Nợ)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="lent-tab" data-bs-toggle="pill" data-bs-target="#lent" type="button">Tôi cho vay (Lent)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="completed-tab" data-bs-toggle="pill" data-bs-target="#completed" type="button">Đã hoàn thành</button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="debtTabsContent">
            <!-- Borrowed Section -->
            <div class="tab-pane fade show active" id="borrowed" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Đối tác</th>
                                <th>Ngày vay</th>
                                <th>Tổng nợ</th>
                                <th>Còn lại</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Where(x => x.DebtType == "BORROWED" && x.Status == "ACTIVE"))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">@d.CounterpartyName</div>
                                        <small class="text-muted">@d.Note</small>
                                    </td>
                                    <td>@d.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@d.InitialAmount.ToString("N0") đ</td>
                                    <td class="text-danger fw-bold">@d.RemainingAmount.ToString("N0") đ</td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Repay" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger">Trả nợ</a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any(x => x.DebtType == "BORROWED" && x.Status == "ACTIVE"))
                            {
                                <tr><td colspan="5" class="text-center py-4 text-muted">Không có khoản nợ nào đang hoạt động.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Lent Section -->
            <div class="tab-pane fade" id="lent" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Người vay</th>
                                <th>Ngày cho vay</th>
                                <th>Tổng tiền</th>
                                <th>Cần thu</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Where(x => x.DebtType == "LENT" && x.Status == "ACTIVE"))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">@d.CounterpartyName</div>
                                        <small class="text-muted">@d.Note</small>
                                    </td>
                                    <td>@d.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@d.InitialAmount.ToString("N0") đ</td>
                                    <td class="text-success fw-bold">@d.RemainingAmount.ToString("N0") đ</td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Repay" asp-route-id="@d.Id" class="btn btn-sm btn-outline-success">Thu nợ</a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any(x => x.DebtType == "LENT" && x.Status == "ACTIVE"))
                            {
                                <tr><td colspan="5" class="text-center py-4 text-muted">Không có khoản cho vay nào đang hoạt động.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Completed Section -->
            <div class="tab-pane fade" id="completed" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Đối tác</th>
                                <th>Loại</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Where(x => x.Status == "COMPLETED"))
                            {
                                <tr>
                                    <td class="ps-4">@d.CounterpartyName</td>
                                    <td>@(d.DebtType == "BORROWED" ? "Nợ" : "Cho vay")</td>
                                    <td>@d.InitialAmount.ToString("N0") đ</td>
                                    <td><span class="badge bg-success">Hoàn thành</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
