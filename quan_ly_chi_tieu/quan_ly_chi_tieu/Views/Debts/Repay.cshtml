@model quan_ly_chi_tieu.Models.ViewModels.RepaymentViewModel
@{
    ViewData["Title"] = Model.DebtType == "BORROWED" ? "Trả nợ" : "Thu nợ";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-4">
            <div class="card-header @(Model.DebtType == "BORROWED" ? "bg-danger" : "bg-success") text-white py-3">
                <h4 class="mb-0">@(Model.DebtType == "BORROWED" ? "⚖️ Thực hiện trả nợ" : "💰 Thực hiện thu nợ")</h4>
            </div>
            <div class="card-body p-4">
                <div class="mb-4 text-center">
                    <p class="text-muted mb-1">Đối tác: <strong>@Model.CounterpartyName</strong></p>
                    <small>Số tiền còn lại cần xử lý</small>
                    <h2 class="fw-bold @(Model.DebtType == "BORROWED" ? "text-danger" : "text-success")">@Model.Amount.ToString("N0") đ</h2>
                </div>

                <form asp-action="Repay" method="post">
                    <input type="hidden" asp-for="DebtId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label fw-bold">Số tiền thanh toán (đ)</label>
                        <input asp-for="Amount" class="form-control form-control-lg fw-bold" type="number" step="1000" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WalletId" class="form-label fw-bold">Ví dùng thanh toán</label>
                        <select asp-for="WalletId" class="form-select">
                            <option value="">-- Chọn ví --</option>
                            @if (Model.Wallets != null)
                            {
                                @foreach (var w in Model.Wallets)
                                {
                                    <option value="@w.Id">@w.Icon @w.Name — @w.CurrentBalance?.ToString("N0") đ</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="WalletId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Date" class="form-label fw-bold">Ngày thực hiện</label>
                        <input asp-for="Date" class="form-control" type="date" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Note" class="form-label fw-bold">Ghi chú</label>
                        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn @(Model.DebtType == "BORROWED" ? "btn-danger" : "btn-success") flex-fill btn-lg shadow-sm">
                            Ghi nhận thanh toán
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
